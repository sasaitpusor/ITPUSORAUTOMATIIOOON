# Variabile pentru scripturile locale (provisioning, generare docs).
# Copiază în .env și completează. .env NU se comite.
#
# Credentialele nu au voie să ajungă în config/, în workflow-urile n8n sau în git.

# Private Integration Token GHL, emis pe sub-contul clientului.
# Scopurile necesare sunt listate în config/clients/<client>.json → integrations.ghl.required_pit_scopes
GHL_PIT=

# Id-ul sub-contului GHL. Numele variabilei e cel din config → integrations.ghl.location_id_env
GHL_LOCATION_ID_DOR_TRAVEL=

# Pentru workflow-ul de generare conținut (faza 2)
ANTHROPIC_API_KEY=
