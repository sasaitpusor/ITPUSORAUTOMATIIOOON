{
  "$schema": "../schema/client.config.schema.json",
  "config_version": "1.0.0",
  "client": {
    "id": "dor-travel",
    "agency_name": "Dor Travel",
    "product_name": "Destinația Ta Perfectă",
    "legal_name": "TBD — see docs/02-intrebari-deschise.md Q4",
    "website": "TBD",
    "locale": "ro-RO",
    "timezone": "Europe/Bucharest",
    "currency": "EUR",
    "business_model": "sejururi organizate (pachet complet), consultanta si recomandare de vacante — NU catalog de hoteluri individuale",
    "support_hours": "Luni–Vineri 09:00–18:00"
  },
  "brand_voice": {
    "tone": "cald, uman, consultativ, fara presiune de vanzare; vorbim ca un consultant care cunoaste clientul, nu ca un newsletter",
    "person": "persoana a doua singular (tu)",
    "avoid": [
      "limbaj de tip clickbait sau urgenta artificiala",
      "superlative nesustinute (\"cea mai buna oferta din Romania\")",
      "promovarea de hoteluri individuale ca produs de sine statator",
      "jargon de agentie (\"pax\", \"BB\", \"DBL\")"
    ],
    "signature_template": "{{consultant_name}} — {{agency_name}}\n{{consultant_phone}} · {{consultant_email}}",
    "positioning_statement": "Nu vindem camere de hotel. Recomandam vacanta potrivita pentru fiecare om, in pachet complet: zbor, transfer, cazare, mese si suport de la plecare pana la intoarcere."
  },
  "integrations": {
    "ghl": {
      "api_base": "https://services.leadconnectorhq.com",
      "auth_mode": "private_integration_token",
      "credential_name_n8n": "GHL PIT — dor-travel",
      "location_id_env": "GHL_LOCATION_ID_DOR_TRAVEL",
      "location_id": "vL4kcgP3mrXaUdOF5PW2",
      "api_versions": {
        "default": "2021-07-28",
        "conversations": "2021-04-15"
      },
      "required_pit_scopes": [
        "contacts.readonly",
        "contacts.write",
        "locations/customFields.readonly",
        "locations/customFields.write",
        "locations/customValues.readonly",
        "locations/customValues.write",
        "locations/tags.readonly",
        "locations/tags.write",
        "conversations.readonly",
        "conversations.write",
        "conversations/message.readonly",
        "conversations/message.write",
        "opportunities.readonly",
        "opportunities.write",
        "users.readonly",
        "workflows.readonly"
      ],
      "token_env": "GHL_PIT_DOR_TRAVEL",
      "secrets_mode": "env"
    },
    "claude": {
      "api_base": "https://api.anthropic.com",
      "credential_name_n8n": "Anthropic API — content generation",
      "model": "claude-opus-5",
      "batch_model": "claude-sonnet-5",
      "max_output_tokens": 4096
    },
    "whatsapp": {
      "enabled": false,
      "provider": "TBD — see docs/02-intrebari-deschise.md Q3",
      "credential_name_n8n": "WhatsApp BSP — dor-travel",
      "sender_id_env": "WA_SENDER_ID_DOR_TRAVEL",
      "session_window_hours": 24,
      "templates": {}
    },
    "sms": {
      "provider": "ghl_native",
      "sender_id_env": null,
      "max_segments": 2,
      "unicode_allowed": false
    },
    "email": {
      "provider": "ghl_native",
      "from_name": "Dor Travel",
      "from_address": "TBD — see docs/02-intrebari-deschise.md Q4",
      "reply_to": "TBD",
      "sending_domain": "TBD",
      "dns_verified": false
    },
    "reporting": {
      "sink": "google_sheets",
      "credential_name_n8n": "Google Sheets — reporting",
      "spreadsheet_id_env": "KPI_SPREADSHEET_ID_DOR_TRAVEL",
      "tabs": {
        "send_log": "send_log",
        "flow_events": "flow_events",
        "attribution": "attribution",
        "content_review": "content_review"
      }
    },
    "alerting": {
      "channel": "email",
      "to_env": "ALERT_EMAIL_DOR_TRAVEL",
      "min_severity": "error"
    }
  },
