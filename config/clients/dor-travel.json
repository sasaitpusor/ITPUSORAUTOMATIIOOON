    "deposit_percent": 20,
    "deposit_percent_confirmed": false,
    "final_payment_days_before_departure": 30,
    "final_payment_days_confirmed": false,
    "source_of_truth": "TBD — see docs/02-intrebari-deschise.md Q9",
    "note": "deposit_percent si final_payment_days_before_departure sunt valorile exemplu din brief; NU se folosesc in texte generate, doar ca merge fields din date reale."
  },
  "consultants": {
    "assignment_strategy": "round_robin",
    "fallback_consultant_id": "TBD",
    "reassign_when_unavailable_after_hours": 4,
    "list": [
      {
        "id": "TBD",
        "name": "TBD — see docs/02-intrebari-deschise.md Q12",
        "email": "TBD",
        "phone": "TBD",
        "whatsapp": "TBD",
        "ghl_user_id": "TBD",
        "active": true,
        "destinations": []
      }
    ]
  },
  "sending_rules": {
    "quiet_hours": {
      "timezone_source": "client.timezone",
      "per_channel": {
        "email": {
          "enforced": false
        },
        "sms": {
          "enforced": true,
          "start": "09:00",
          "end": "20:00"
        },
        "whatsapp": {
          "enforced": true,
          "start": "09:00",
          "end": "20:00"
        }
      },
      "defer_strategy": "next_window_start"
    },
    "frequency_cap": {
      "commercial": {
        "max_messages": 3,
        "rolling_days": 7
      },
      "min_hours_between_commercial": 24,
      "transactional_bypasses_cap": true
    },
    "suppression": {
      "commercial_flow_ids": [
        "nurturing",
        "early_booking",
        "last_minute",
        "personalized_offers",
        "birthday",
        "reactivation_6m",
        "reactivation_12m",
        "referral",
        "offer_no_response",
        "review_request"
      ],
      "exclusive_flow_ids": [
        "pre_departure",
        "in_trip",
        "pre_return"
      ],
      "rule": "cat timp contactul are un flux din exclusive_flow_ids activ, orice mesaj cu flow_id din commercial_flow_ids este suprimat (nu amanat)."
    },
    "idempotency": {
      "key_template": "{{client_id}}:{{contact_id}}:{{flow_id}}:{{step_id}}:{{occurrence_key}}",
      "store": "contact_field",
      "field_key": "jurnal_trimiteri",
      "ttl_days": 400
    },
    "log": {
      "field_key": "jurnal_trimiteri",
      "retention_days": 400,
      "human_readable_fields": {
        "last_commercial": "ultim_mesaj_comercial",
        "count_rolling": "mesaje_comerciale_7z"
      }
    }
  },
  "compliance": {
    "consent_required_per_channel": true,
    "consent_fields": {
      "email": {
        "flag": "consim_email",
        "date": "consim_email_data",
        "source": "consim_email_sursa"
      },
      "sms": {
        "flag": "consim_sms",
        "date": "consim_sms_data",
        "source": "consim_sms_sursa"
      },
      "whatsapp": {
        "flag": "consim_whatsapp",
        "date": "consim_whatsapp_data",
        "source": "consim_whatsapp_sursa"
      }
    },
    "optout_tags": {
      "email": "optout_email",
      "sms": "optout_sms",
      "whatsapp": "optout_whatsapp"
    },
    "sms_stop_keywords": [
